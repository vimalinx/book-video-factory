        {"file": "ZhiMangXing-Regular.ttf", "family": "Zhi Mang Xing"}
      ]
    },
    "english": {
      "description": "Latin sans-serif for bilingual subtitles and labels.",
      "required_script": "Latn",
      "candidates": [
        {"file": "NotoSans-Regular.ttf", "family": "Noto Sans"},
        {"file": "NotoSans-Medium.ttf", "family": "Noto Sans"},
        {"file": "DejaVuSans.ttf", "family": "DejaVu Sans"},
        {"file": "LiberationSans-Regular.ttf", "family": "Liberation Sans"},
        {"file": "Helvetica.ttc", "family": "Helvetica"},
        {"file": "arial.ttf", "family": "Arial"}
      ]
    },
    "english_serif": {
      "description": "Latin serif for the bilingual editorial secondary caption.",
      "required_script": "Latn",
      "candidates": [
        {"file": "NotoSerif-Regular.ttf", "family": "Noto Serif"},
        {"file": "DejaVuSerif.ttf", "family": "DejaVu Serif"},
        {"file": "LiberationSerif-Regular.ttf", "family": "Liberation Serif"},
        {"file": "Times New Roman.ttf", "family": "Times New Roman"},
        {"file": "times.ttf", "family": "Times New Roman"}
      ]
    }
  },
  "install_hints": {
    "linux": {
      "pacman": "sudo pacman -S noto-fonts-cjk noto-fonts",
      "apt": "sudo apt install fonts-noto-cjk fonts-noto",
      "dnf": "sudo dnf install google-noto-sans-cjk-fonts google-noto-fonts",
      "generic": "Install Noto Sans CJK SC and Noto Sans through your package manager."
    },
    "darwin": {
      "generic": "brew install --cask font-noto-sans-cjk-sc font-noto-sans"
    },
    "win32": {
      "generic": "Install Noto Sans SC from https://fonts.google.com/noto/specimen/Noto+Sans+SC"
    }
  }
}
